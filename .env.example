# Environment variables for Prox Welding Agent
# Copy this to .env and fill in your values

# Path to your Obsidian vault (can be absolute or relative to project root)
VAULT_PATH=bidirectional prox

# Directory containing PDF files (relative to project root)
FILES_DIR=files

# Your Anthropic API key (required for Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here